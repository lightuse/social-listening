# ====================================
# Social Listening System 環境変数サンプル
# ====================================
# このファイルをコピーして .env として使用してください
# cp .env.example .env

# アプリケーション設定
APP_NAME="Social Listening System"
ENVIRONMENT=development
DEBUG=true

# データベース設定
DATABASE_URL=sqlite+aiosqlite:///./data/social_listening.db

# Redis設定
REDIS_URL=redis://localhost:6379

# ====================================
# AWS Bedrock設定 (必須)
# ====================================
AWS_REGION=us-east-1
# AWSコンソールのIAMから取得してください
# https://console.aws.amazon.com/iam/
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
# 一時的なアクセスキー（ASIAで始まる）を使用する場合は、SESSION_TOKENも必要
AWS_SESSION_TOKEN=your_session_token_here

# セキュリティ設定
# SECRET_KEYは以下のコマンドで生成してください:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-super-secret-key-here-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ====================================
# Twitter API設定 (オプション)
# ====================================
# Twitter Developer Portalから取得してください
# https://developer.twitter.com/
TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here
TWITTER_API_KEY=your_twitter_api_key_here
TWITTER_API_SECRET=your_twitter_api_secret_here
TWITTER_ACCESS_TOKEN=your_twitter_access_token_here
TWITTER_ACCESS_TOKEN_SECRET=your_twitter_access_token_secret_here

# ====================================
# 外部API設定 (オプション)
# ====================================
# Google Cloud Consoleから取得してください
# https://console.cloud.google.com/
YOUTUBE_API_KEY=your_youtube_api_key_here

# Reddit App設定から取得してください
# https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here

# ====================================
# API設定
# ====================================
API_V1_STR="/api/v1"

# ====================================
# 収集設定
# ====================================
COLLECTION_INTERVAL=3600
MAX_POSTS_PER_COLLECTION=1000
RATE_LIMIT_DELAY=1.0

# ====================================
# AI モデル設定
# ====================================
DEFAULT_MODEL=amazon.nova-lite-v1:0
EMBEDDING_MODEL=amazon.titan-embed-text-v1
SENTIMENT_THRESHOLD=0.7

# ====================================
# レポート設定
# ====================================
REPORT_GENERATION_TIMEOUT=900
MAX_REPORT_ITEMS=500

# Logging
LOG_LEVEL=info
ALLOWED_HOSTS=["*"]
